# ===================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# Copia este archivo como .env y coloca tus valores reales.
# NUNCA subas tu archivo .env real con claves privadas a GitHub.
# ===================================================================

# Clave de API de Google Gemini (Obligatoria - Obtenla gratis en: https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Google Gemini ultra rápido y estable (gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Puerto del servidor web (Render inyecta su propio puerto automáticamente)
PORT=3000

# Entorno de ejecución
NODE_ENV=production

# Zona horaria oficial para el control de horarios
TIMEZONE=America/Bogota

# Control de restricción horaria: true = respeta horarios; false = atiende 24/7
ENABLE_SCHEDULE_RESTRICTION=true

# Tiempo de espera (en minutos) para no repetir el mensaje de fuera de horario al mismo usuario
OFF_HOURS_COOLDOWN_MINUTES=60

# --- VINCULACIÓN DE WHATSAPP ---
# false = Vinculación mediante escaneo de código QR (en consola o en /qr)
# true  = Vinculación mediante código de 8 dígitos para ingresar en WhatsApp del celular
USE_PAIRING_CODE=false

# Si USE_PAIRING_CODE=true, escribe el número con código de país (sin +, ej: 573001234567)
PHONE_NUMBER=
