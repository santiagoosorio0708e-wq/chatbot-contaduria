# Clave de API de Google Gemini (Obligatoria)
GEMINI_API_KEY="tu_clave_de_gemini_aqui"

# Puerto del servidor HTTP (Render lo asigna automáticamente)
PORT=3000

# Horarios de atención comercial (Formato 24h: HH:MM)
BUSINESS_MORNING_START="08:30"
BUSINESS_MORNING_END="12:30"
BUSINESS_AFTERNOON_START="14:00"
BUSINESS_AFTERNOON_END="18:00"

# Opciones avanzadas (Opcionales)
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome-stable"
# WWEBJS_DATA_PATH="./.wwebjs_auth"
